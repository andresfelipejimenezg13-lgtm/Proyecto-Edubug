# Copia este archivo como ".env" para pruebas locales (NO lo subas a GitHub).
# En Render estas mismas variables se definen en Environment.

SECRET_KEY=pon-aqui-una-cadena-larga-y-secreta

# Archivo SQLite (base relacional principal: 11 tablas)
SQLITE_PATH=instance/edudebug_v2.db

# MongoDB Atlas (Connect > Drivers). Si lo dejas vacío la app funciona, pero sin las funciones NoSQL.
# MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=edudebug

# Dirección del frontend permitido (varias separadas por coma). "*" = cualquiera.
CORS_ORIGINS=*

# 1 = crea estudiante@edudebug.com y profesor@edudebug.com (contraseña 123456). Ponlo en 0 en producción real.
SEED_DEMO=1
