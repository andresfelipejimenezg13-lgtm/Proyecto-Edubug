# Copia este archivo como ".env" para pruebas locales (NO lo subas a GitHub).
# En Render estas mismas variables se definen en Environment.

# Firma los tokens JWT: si alguien la conoce puede fabricar sesiones. Usa una cadena larga y aleatoria.
SECRET_KEY=pon-aqui-una-cadena-larga-y-secreta

# --- Seguridad (Entrega 3) ---
# Horas de vida del token de sesión
TOKEN_HORAS=8
# Intentos de login fallidos permitidos por (IP + correo) y minutos de bloqueo
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15
# Opcional: crea (si no existe) una cuenta de administrador al arrancar. Úsalo en producción con SEED_DEMO=0.
# ADMIN_EMAIL=admin@tudominio.com
# ADMIN_PASSWORD=UnaClaveLarga123

# Archivo SQLite (base relacional principal: 11 tablas)
SQLITE_PATH=instance/edudebug_v2.db

# MongoDB Atlas (Connect > Drivers). Si lo dejas vacío la app funciona, pero sin las funciones NoSQL.
# MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=edudebug

# Dirección del frontend permitido (varias separadas por coma). "*" = cualquiera.
CORS_ORIGINS=*

# 1 = crea estudiante@, profesor@ y admin@edudebug.com (contraseña 123456). Ponlo en 0 en producción real.
SEED_DEMO=1
