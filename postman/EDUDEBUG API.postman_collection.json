    {
      "name": "2. Diagnóstico (login estudiante primero)",
      "item": [
        {
          "name": "Iniciar test",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('Respuesta correcta', () => pm.expect(pm.response.code).to.eql(200));",
                  "if (!d.finalizado) {",
                  "  pm.collectionVariables.set('idTest', d.idTest);",
                  "  pm.collectionVariables.set('idPregunta', d.pregunta.idPregunta);",
                  "  pm.collectionVariables.set('idOpcion', d.pregunta.opciones[0].idOpcion);",
                  "  console.log('Pregunta ' + d.numero + ' de ' + d.total + ' -> se guardó la 1ª opción; cambia {{idOpcion}} si quieres otra');",
                  "} else { console.log('Test terminado. Nivel: ' + d.nivel); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/diagnostico/iniciar",
